# ==============================================================================
# AMIGOS FASHIONSTOP - Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://amigosfashionstop.com

# Admin Portal Authentication (Server-Side Only - Set in Vercel Environment Variables)
ADMIN_ID=Admin
ADMIN_PASSWORD=your_secure_production_admin_password
ADMIN_SESSION_SECRET=your_32_char_cryptographic_random_session_secret

# Razorpay Indian Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_AmigosStoreKey
RAZORPAY_KEY_SECRET=rzp_live_AmigosStoreSecret
RAZORPAY_WEBHOOK_SECRET=amigos_webhook_secret_key

# WhatsApp Boutique Contacts
NEXT_PUBLIC_PRIMARY_WHATSAPP=919820140138
NEXT_PUBLIC_SECONDARY_WHATSAPP=919892880586
NEXT_PUBLIC_WHOLESALE_WHATSAPP=919324767743

# Database Connection (PostgreSQL Production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/amigos_fashionstop

# Transactional Email (Resend / SendGrid / Postmark)
EMAIL_FROM=orders@amigosfashionstop.com
RESEND_API_KEY=re_your_api_key_here

# Shipping Adapter (Shiprocket Indian Logistics)
SHIPROCKET_API_KEY=your_shiprocket_api_key
SHIPROCKET_EMAIL=amigosfashionstop@gmail.com
SHIPROCKET_PASSWORD=your_shiprocket_password
